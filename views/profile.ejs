<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <script src="http://cdn.tailwindcss.com"> </script>
</head>
<body>
    <div class="w-full p-4 min-h-screen bg-gray-500">
        <div class="flex flex-row-reverse justify-between">
            <a href="/logout" class="bg-red-500 rounded-md px-3 py-2 text-sm mb-5 inline-block">Logout</a>
            <h1 class="text-xl font-bold"><span class="font-light italic">Hello</span>, <%= user.name %> 👋 </h1>
        </div>
        <h5 class="mb-5">You can create a new post.</h5>

        <form action="/post" method="post" class="flex flex-col px-12 justify-start text-white">
            <textarea class="resize-none block w-96 m-2 p-2 rounded-md bg-transparent outline-none border-2 border-gray-400 focus:bg-gray-800 hover:bg-gray-700" placeholder="Write your mind here!" name="content"></textarea>
            <input class="shadow-md ml-6 py-1 w-fit block px-4 bg-gray-900 rounded-3xl cursor-pointer hover:bg-gray-500 transition duration-200 active:bg-gray-700 hover:text-gray-900" type="submit" value="Create new post">
        </form>

        <div class="posts mt-20">
            <h3 class="text-xl text-zinc-800">Your Posts</h3>
            <div class="postcontainer mt-5">
                <% user.posts.reverse().forEach(function(post) { %>
                    <div class="post mb-5 w-1/3 p-5 border-[1px] border-gray-400 bg-gray-600 rounded-md">
                        <h4 class="text-blue-500 font-bold italic">@<%= user.username %></h4>
                        <p class="text-white text-sm tracking-tight"><%= post.content %></p>
                        <small class="mt-2 inline-block">
                            <span class="font-bold"><%= post.likes.length %> </span>
                            <%= post.likes.length === 0 || 1 ? 'like' : 'likes' %>
                        </small>
                        <div class="btns mt-2 flex gap-6">
                            <a href="/like/<%= post._id%>" class="hover:underline text-blue-500">
                                <%= post.likes.includes(user._id) ? 'Unlike' : 'Like' %>
                            </a></a>
                            <a href="/edit/<%= post._id%>" class="hover:underline hover:text-gray-400">Edit</a>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</body>
</html>
